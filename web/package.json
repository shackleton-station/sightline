{
  "name": "sightline-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "bash scripts/dev-server.sh",
    "build": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "build:worker": "esbuild events-worker/index.ts --bundle --platform=node --format=cjs --outfile=dist-worker/index.cjs",
    "start:worker": "node dist-worker/index.cjs",
    "build:plans": "esbuild plans/index.ts --bundle --platform=node --format=cjs --outfile=dist-plans/index.cjs",
    "start:plans": "DATA_DIR=public/data node dist-plans/index.cjs",
    "build:copilot": "esbuild copilot/index.ts --bundle --platform=node --format=cjs --outfile=dist-copilot/index.cjs",
    "start:copilot": "DATA_DIR=public/data node dist-copilot/index.cjs",
    "build:cluster-drill": "esbuild copilot/clusterDrill.ts --bundle --platform=node --format=cjs --outfile=dist-copilot/cluster-drill.cjs",
    "start": "node dist-server/index.js",
    "lint": "oxlint && biome lint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "upload-tiles": "node scripts/check-tiles.mjs && gcloud storage rsync --recursive public/tiles gs://clps-compute-6z1nc-web-assets/tiles",
    "upload-light": "gcloud storage rsync --recursive public/tiles/light gs://clps-compute-6z1nc-web-assets/tiles/light"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hono/node-server": "^2.1.7",
    "d3": "^7.9.0",
    "google-auth-library": "^11.3.4",
    "hono": "^4.13.18",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
